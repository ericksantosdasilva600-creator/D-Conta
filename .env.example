# Exemplo sem valores reais. Copiar para .env apenas no ambiente local autorizado.
# Nunca guardar segredos verdadeiros neste ficheiro nem no Git.

# Identidade OAuth do projeto (identificador público)
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Segredos server-side obrigatórios para autenticação e sincronização
MANUS_JWT_SECRET=
DATABASE_URL=

# Endpoint opcional de API para desenvolvimento/Preview/nativo.
# Web publicado na mesma origem pode deixar vazio.
EXPO_PUBLIC_API_BASE_URL=

# Identificador opcional que recebe role admin durante a criação/atualização da conta.
OWNER_OPEN_ID=
OWNER_NAME=

# Integrações auxiliares do starter Manus; não necessárias ao fluxo principal do Nyvo.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Runtime local
PORT=3000
NODE_ENV=development

# Aliases antigos, apenas para compatibilidade com ambientes anteriores:
# JWT_SECRET=
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_APP_ID=
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_OWNER_OPEN_ID=
# EXPO_PUBLIC_OWNER_NAME=
